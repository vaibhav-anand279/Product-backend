// This is your Prisma schema file
// Docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"

}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Product {
  id        Int      @id @default(autoincrement())
  sku       String   @unique
  name      String
  brand     String
  color     String?
  size      String?
  mrp       Float
  price     Float
  quantity  Int
  createdAt DateTime @default(now())
}
